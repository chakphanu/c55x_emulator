#!/usr/bin/env python3
"""c55x-contained: the supported way to run the emulator core and heavy work.

Runs a payload as a systemd user service inside the shared slice c55x.slice
(cgroup v2), reads the limits back from the kernel inside the job before the
payload starts, admits at most one emulator job per slot (eight slots), and
reports a distinct outcome for each failure class. There is no fallback: if
containment cannot be verified the payload does not run.

Usage:
  c55x-contained [--job emulator|work] [--mem SIZE] [--cpu-sec N]
                 [--wall-sec N] [--work-dir DIR] [--env NAME]... -- CMD [ARG...]
  c55x-contained --status

Exit codes (see .claude/skills/c55x-contained/SKILL.md):
  0 ok | 1-63 payload's own status | 70 incomplete or reserved-code collision
  74 host headroom low | 75 busy | 77 policy refused | 79 local cgroup OOM
  124 wall or CPU time limit | 128+N payload killed by signal N
Code 78 is internal (job-side verification failed) and never returned.
"""

import argparse
import errno
import fcntl
import os
import signal
import subprocess
import sys
import time
import uuid
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
SLICE = "c55x.slice"
EMU_UNIT = "c55x-emu.service"    # slot 0; slot k > 0 is c55x-emu-<k>.service
SLOTS = 8                        # concurrent emulator jobs
LOCK_DIR = Path("/run/user") / str(os.getuid()) / "c55x-contained"

GIB = 1024 ** 3
MAX_MEM_BYTES = 2 * GIB          # hard ceiling for one job
MAX_CPU_SEC = 600
MAX_WALL_SEC = 900
MIN_HEADROOM_BYTES = 16 * GIB    # host MemAvailable needed to admit a job
SLICE_MEM_MAX = 18 * GIB
SLICE_MEM_HIGH = 17 * GIB
SLICE_TASKS = 448
SLICE_CPU_QUOTA = (1000000, 100000)
JOB_TASKS = 32
JOB_CPU_QUOTA = (100000, 100000)
JOB_FDS = 512
JOB_STOP_SEC = 5
AS_EMULATOR = 8 * GIB            # RLIMIT_AS (virtual); physical use stays bounded by the cgroup
AS_WORK = 16 * GIB

RC_INCOMPLETE, RC_HEADROOM, RC_BUSY, RC_POLICY = 70, 74, 75, 77
RC_INNER_POLICY, RC_OOM, RC_TIMEOUT = 78, 79, 124
RESERVED = {RC_INCOMPLETE, RC_HEADROOM, RC_BUSY, RC_POLICY, RC_INNER_POLICY,
            RC_OOM, RC_TIMEOUT}

# Variable NAMES forwarded to the job (values come from this process's
# environment via `--setenv=NAME`, so no value appears in any argv).
FORWARD_EXACT = {"PATH", "HOME", "USER", "LOGNAME", "LANG", "LANGUAGE", "TERM",
                 "PYTHONPATH", "PYTHONHASHSEED", "PYTHONDONTWRITEBYTECODE",
                 "VIRTUAL_ENV", "CARGO_HOME", "RUSTUP_HOME", "CARGO_TARGET_DIR",
                 "RUSTFLAGS", "CC", "CXX", "CFLAGS", "CXXFLAGS", "LDFLAGS",
                 "ASAN_OPTIONS", "UBSAN_OPTIONS"}
FORWARD_PREFIX = ("LC_", "ZEN_", "C55X_")
NEVER_FORWARD = {"C55X_CONTAINED_JOB", "TMPDIR", "XDG_RUNTIME_DIR",
                 "DBUS_SESSION_BUS_ADDRESS"}
THREAD_VARS = ("OMP_NUM_THREADS", "OPENBLAS_NUM_THREADS", "MKL_NUM_THREADS",
               "NUMEXPR_NUM_THREADS", "VECLIB_MAXIMUM_THREADS",
               "RAYON_NUM_THREADS")


def eprint(msg):
    sys.stderr.write("c55x-contained: %s\n" % msg)


def die(rc, outcome, msg):
    eprint("outcome=%s %s" % (outcome, msg))
    sys.exit(rc)


def parse_size(text):
    t = text.strip().upper()
    mult = {"G": GIB, "M": 1024 ** 2, "K": 1024}.get(t[-1:], None)
    digits = t[:-1] if mult else t
    if not digits.isdigit():
        raise ValueError("bad size %r" % text)
    return int(digits) * (mult or 1)


# ------------------------------------------------------------ user manager

def user_bus_env():
    """(env, runtime_dir) for the caller's user manager, or None. The
    runtime directory must be a directory owned by this user and its bus a
    socket; nothing is taken from ambient variables without that check."""
    uid = os.getuid()
    seen = []
    for rt in (os.environ.get("XDG_RUNTIME_DIR"), "/run/user/%d" % uid):
        if not rt or rt in seen:
            continue
        seen.append(rt)
        p = Path(rt)
        try:
            st = p.stat()
            if not p.is_dir() or st.st_uid != uid:
                continue
            bus = p / "bus"
            if not bus.is_socket() or bus.stat().st_uid != uid:
                continue
        except OSError:
            continue
        env = dict(os.environ)
        env["XDG_RUNTIME_DIR"] = str(p)
        env["DBUS_SESSION_BUS_ADDRESS"] = "unix:path=%s" % bus
        return env, p
    return None


def systemctl(env, *args):
    return subprocess.run(["systemctl", "--user", *args], env=env,
                          capture_output=True, text=True)


def unit_props(env, unit, *names):
    out = systemctl(env, "show", unit, *sum((["-p", n] for n in names), [])).stdout
    props = {}
    for line in out.splitlines():
        k, _, v = line.partition("=")
        props[k] = v
    return props


def unit_state(env, unit):
    """ActiveState of the unit ("" if it cannot be read)."""
    return unit_props(env, unit, "ActiveState").get("ActiveState", "")


def state_is_free(state):
    # Only a unit that is not loaded (reported as inactive), inactive or
    # failed leaves its slot free; activating, active, reloading,
    # deactivating (the stop grace) or an unreadable state keep it busy.
    return state in ("inactive", "failed")


def set_slice_limits(env):
    r = systemctl(env, "set-property", "--runtime", SLICE,
                  "MemoryMax=%d" % SLICE_MEM_MAX, "MemoryHigh=%d" % SLICE_MEM_HIGH,
                  "MemorySwapMax=0", "TasksMax=%d" % SLICE_TASKS,
                  "CPUQuota=%d%%" % (SLICE_CPU_QUOTA[0] // 1000))
    if r.returncode != 0:
        die(RC_POLICY, "policy", "cannot configure %s: %s" % (SLICE, r.stderr.strip()[:200]))


# ------------------------------------------------------------ host checks

def mem_available():
    with open("/proc/meminfo") as f:
        for line in f:
            if line.startswith("MemAvailable:"):
                real = int(line.split()[1]) * 1024
                break
        else:
            return 0
    # Test hook: a LOWER value can be injected (never a higher one), so it
    # can only make admission stricter.
    inj = os.environ.get("C55X_TEST_MEM_AVAILABLE_BYTES", "")
    if inj.isdigit():
        real = min(real, int(inj))
    return real


def on_tmpfs(path):
    """True if the resolved path lies on a tmpfs or ramfs mount."""
    p = Path(path).resolve()
    best = None
    try:
        with open("/proc/self/mountinfo") as f:
            for line in f:
                left, sep, right = line.partition(" - ")
                if not sep:
                    continue
                fields = left.split()
                fstype = right.split()[0] if right.split() else ""
                if len(fields) < 5:
                    continue
                mp = Path(fields[4].replace("\\040", " "))
                try:
                    p.relative_to(mp)
                except ValueError:
                    continue
                if best is None or len(str(mp)) >= len(str(best[0])):
                    best = (mp, fstype)
    except OSError:
        return True            # cannot verify: treat as unsafe
    return best is None or best[1] in ("tmpfs", "ramfs", "devtmpfs")


# ------------------------------------------------------------ admission

def slot_unit(k):
    return EMU_UNIT if k == 0 else "c55x-emu-%d.service" % k


def slot_lock(k):
    return "emulator.lock" if k == 0 else "emulator-%d.lock" % k


EMU_UNITS = tuple(slot_unit(k) for k in range(SLOTS))


def slot_count():
    # Test hook: a LOWER slot count can be injected (never a higher one), so
    # it can only make admission stricter.
    n = SLOTS
    inj = os.environ.get("C55X_TEST_SLOTS", "")
    if inj.isdigit():
        n = min(n, int(inj))
    return n


class Admission:
    """Per-user emulator slots. Slot k is an advisory lock (owner pid
    recorded) plus a fixed unit name, so a job orphaned by a dead launcher
    still blocks its own slot until it ends."""

    def __init__(self):
        self.fd = None
        self.unit = None
        self.busy = []

    def acquire(self, env):
        """Take the first slot whose lock is free and whose unit is
        inactive, failed or not loaded. Returns its unit name, or None with
        self.busy describing every slot when all are taken."""
        LOCK_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
        self.busy = []
        for k in range(slot_count()):
            unit = slot_unit(k)
            fd = os.open(str(LOCK_DIR / slot_lock(k)), os.O_CREAT | os.O_RDWR, 0o600)
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except OSError as e:
                os.close(fd)
                if e.errno in (errno.EWOULDBLOCK, errno.EAGAIN):
                    self.busy.append("%s held" % unit)
                    continue
                raise
            state = unit_state(env, unit)
            if not state_is_free(state):   # e.g. orphaned by a dead launcher
                os.close(fd)
                self.busy.append("%s %s" % (unit, state or "state unreadable"))
                continue
            os.ftruncate(fd, 0)
            os.write(fd, b"%d\n" % os.getpid())
            self.fd, self.unit = fd, unit
            return unit
        return None

    def release(self):
        if self.fd is not None:
            os.close(self.fd)          # closing drops the flock
            self.fd = None


# ------------------------------------------------------------ job-side verify

def cgroup2_dir():
    """Directory of this process's cgroup, mapped through the real cgroup2
    mount (mountinfo), or None."""
    rel = None
    for line in Path("/proc/self/cgroup").read_text().splitlines():
        if line.startswith("0::"):
            rel = line[3:].strip()
    if not rel:
        return None
    for line in Path("/proc/self/mountinfo").read_text().splitlines():
        left, sep, right = line.partition(" - ")
        if sep and right.split()[:1] == ["cgroup2"]:
            f = left.split()
            root, mnt = f[3], f[4]
            try:
                under = Path(rel).relative_to(root)
            except ValueError:
                return None
            if ".." in under.parts:
                return None
            return Path(mnt) / under
    return None


def read_value(d, name):
    return (d / name).read_text().strip()


def inner_verify(args):
    """Runs INSIDE the job before the payload: compare kernel readbacks with
    the exact expected values, then exec the payload. Exit 78 on mismatch."""
    def fail(msg):
        eprint("outcome=policy job-side verification failed: %s" % msg)
        try:                     # lets the launcher tell this apart from a payload exit 78
            LOCK_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
            (LOCK_DIR / (args.unit + ".verify-failed")).write_text("1\n")
        except OSError:
            pass
        sys.exit(RC_INNER_POLICY)

    if os.environ.get("C55X_CONTAINED_JOB") == "emulator" and args.unit not in EMU_UNITS:
        fail("unit %s is not an emulator slot unit" % args.unit)
    d = cgroup2_dir()
    if d is None:
        fail("cannot resolve the cgroup2 membership")
    # the job directory is the one named after our unit, directly below the slice
    job = None
    for cand in [d, *d.parents]:
        if cand.name == args.unit and cand.parent.name == SLICE:
            job = cand
            break
    if job is None:
        fail("process is not in %s/%s" % (SLICE, args.unit))
    slc = job.parent
    try:
        want_job = {
            "memory.max": str(args.mem_bytes), "memory.swap.max": "0",
            "pids.max": str(JOB_TASKS), "memory.oom.group": "1",
            "cpu.max": "%d %d" % JOB_CPU_QUOTA,
        }
        want_slice = {
            "memory.max": str(SLICE_MEM_MAX), "memory.high": str(SLICE_MEM_HIGH),
            "memory.swap.max": "0", "pids.max": str(SLICE_TASKS),
            "cpu.max": "%d %d" % SLICE_CPU_QUOTA,
        }
        for where, want in ((job, want_job), (slc, want_slice)):
            for name, expect in want.items():
                got = read_value(where, name)
                if got != expect:
                    fail("%s/%s = %r, expected %r" % (where.name, name, got, expect))
    except OSError as e:
        fail("controller file unreadable: %s" % e)
    import resource
    for res, want, label in ((resource.RLIMIT_CPU, args.cpu_sec, "RLIMIT_CPU"),
                             (resource.RLIMIT_NOFILE, JOB_FDS, "RLIMIT_NOFILE"),
                             (resource.RLIMIT_CORE, 0, "RLIMIT_CORE"),
                             (resource.RLIMIT_AS, args.as_bytes, "RLIMIT_AS")):
        if resource.getrlimit(res) != (want, want):
            fail("%s = %r, expected %r" % (label, resource.getrlimit(res), (want, want)))
    os.execvp(args.cmd[0], args.cmd)


# ------------------------------------------------------------ outer launcher

def forwarded_names(extra=()):
    names = [n for n in extra if n in os.environ and n not in NEVER_FORWARD]
    for n in os.environ:
        if n in NEVER_FORWARD:
            continue
        if n in FORWARD_EXACT or n.startswith(FORWARD_PREFIX):
            names.append(n)
    return sorted(names)


def classify(env, unit, rc, cpu_sec):
    """Map the finished unit to (exit code, outcome, message)."""
    p = unit_props(env, unit, "LoadState", "Result", "ExecMainStatus", "CPUUsageNSec")
    result, load = p.get("Result", ""), p.get("LoadState", "")
    try:
        status = int(p.get("ExecMainStatus", "0") or 0)
    except ValueError:
        status = 0
    try:
        cpu_ns = int(p.get("CPUUsageNSec", "0") or 0)
    except ValueError:
        cpu_ns = 0
    systemctl(env, "reset-failed", unit)           # exactly this unit only
    marker = LOCK_DIR / (unit + ".verify-failed")
    verify_failed = marker.exists()
    if verify_failed:
        marker.unlink()
    if load == "not-found":
        if rc == 0:
            return 0, "payload", "rc=0"
        return RC_POLICY, "policy", "the job could not be started (systemd-run rc=%d)" % rc
    if result == "oom-kill":
        return RC_OOM, "oom", "the job reached its memory ceiling and was killed"
    if result == "timeout":
        return RC_TIMEOUT, "timeout", "the job reached its wall-time limit"
    if result in ("signal", "core-dump"):
        if status == 24 or (status == 9 and cpu_ns >= 0.95e9 * cpu_sec):
            return RC_TIMEOUT, "timeout", "the job reached its CPU-time limit (%ds)" % cpu_sec
        return 128 + status, "signal", "the job was killed by signal %d" % status
    if result in ("success", "exit-code"):
        if rc == RC_INNER_POLICY and verify_failed:
            return RC_POLICY, "policy", "job-side containment verification failed (see above)"
        if rc in RESERVED:
            return RC_INCOMPLETE, "incomplete", \
                "the payload exited with reserved code %d" % rc
        return rc, "payload", "rc=%d" % rc
    return RC_INCOMPLETE, "incomplete", "unit ended with Result=%s" % (result or "unknown")


def run_job(args):
    bus = user_bus_env()
    if bus is None:
        die(RC_POLICY, "policy", "no usable user manager (owned runtime dir and bus socket)")
    env, _ = bus

    if args.status:
        return do_status(env)

    mem = parse_mem(args)
    if args.cpu_sec < 1 or args.cpu_sec > MAX_CPU_SEC:
        die(RC_POLICY, "policy", "--cpu-sec must be 1..%d" % MAX_CPU_SEC)
    if args.wall_sec < 1 or args.wall_sec > MAX_WALL_SEC:
        die(RC_POLICY, "policy", "--wall-sec must be 1..%d" % MAX_WALL_SEC)
    if not args.cmd:
        die(RC_POLICY, "policy", "no command after --")
    work_dir = Path(args.work_dir).resolve()
    probe = work_dir                       # nearest existing ancestor decides the
    while not probe.exists() and probe != probe.parent:     # filesystem; check
        probe = probe.parent                                # BEFORE creating anything
    if on_tmpfs(probe):
        die(RC_POLICY, "policy", "work dir %s is on tmpfs or cannot be verified; "
            "use a disk-backed directory" % work_dir)
    work_dir.mkdir(parents=True, exist_ok=True)

    avail = mem_available()
    if avail < MIN_HEADROOM_BYTES:
        die(RC_HEADROOM, "headroom", "MemAvailable %.1f GiB < %d GiB" %
            (avail / GIB, MIN_HEADROOM_BYTES // GIB))

    adm = None
    if args.job == "emulator":
        adm = Admission()
        unit = adm.acquire(env)
        if unit is None:
            die(RC_BUSY, "busy", "all %d emulator slots are busy (%s); wait for one (a unit "
                "running without a launcher stops by itself within its wall-time limit)"
                % (slot_count(), ", ".join(adm.busy) or "none configured"))
        systemctl(env, "reset-failed", unit)      # clear only a finished leftover
    else:
        unit = "c55x-work-%d-%s.service" % (os.getpid(), uuid.uuid4().hex[:8])

    set_slice_limits(env)
    stale = LOCK_DIR / (unit + ".verify-failed")
    if stale.exists():
        stale.unlink()
    as_bytes = AS_EMULATOR if args.job == "emulator" else AS_WORK
    props = ["MemoryMax=%d" % mem, "MemorySwapMax=0", "TasksMax=%d" % JOB_TASKS,
             "CPUQuota=%d%%" % (JOB_CPU_QUOTA[0] // 1000), "OOMPolicy=kill",
             "RuntimeMaxSec=%d" % args.wall_sec, "TimeoutStopSec=%d" % JOB_STOP_SEC,
             "LimitCPU=%d" % args.cpu_sec, "LimitNOFILE=%d" % JOB_FDS,
             "LimitCORE=0", "LimitAS=%d" % as_bytes]
    cmd = ["systemd-run", "--user", "--wait", "--pipe", "--quiet",
           "--expand-environment=no", "--slice=" + SLICE, "--unit=" + unit,
           "--working-directory", os.getcwd()]
    for p in props:
        cmd += ["-p", p]
    cmd += ["--setenv=C55X_CONTAINED_JOB=" + args.job,
            "--setenv=TMPDIR=" + str(work_dir)]
    for v in THREAD_VARS:
        cmd += ["--setenv=%s=1" % v]
    for n in forwarded_names(args.env):
        cmd += ["--setenv=" + n]
    inner = [sys.executable, os.path.abspath(__file__), "--inner", "--unit", unit,
             "--mem-bytes", str(mem), "--cpu-sec", str(args.cpu_sec),
             "--as-bytes", str(as_bytes), "--"]
    cmd += ["--", *inner, *args.cmd]

    # A unit of this name that is still loaded keeps its InvocationID if
    # systemd-run cannot start ours; its Result must not be reported as ours.
    before = unit_props(env, unit, "InvocationID").get("InvocationID", "")
    proc = subprocess.Popen(cmd, env=env)
    state = {"signal": None}

    def stop_own_unit(signum, _frame):
        state["signal"] = signum
        systemctl(env, "stop", unit)               # exactly our unit, nothing else

    old = {s: signal.signal(s, stop_own_unit)
           for s in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP)}
    try:
        rc = proc.wait()
    finally:
        for s, h in old.items():
            signal.signal(s, h)
    if state["signal"] is not None:
        systemctl(env, "reset-failed", unit)
        if adm:
            adm.release()
        die(128 + state["signal"], "interrupted",
            "launcher received signal %d; its job unit was stopped" % state["signal"])

    after = unit_props(env, unit, "LoadState", "InvocationID", "ActiveState")
    if after.get("LoadState", "") not in ("", "not-found") and \
            after.get("InvocationID", "") == before:
        if adm:
            adm.release()
        die(RC_BUSY, "busy", "systemd-run (rc=%d) did not start a new %s: a unit of that "
            "name is still loaded (ActiveState=%s); wait and retry" % (
                rc, unit, after.get("ActiveState", "") or "unknown"))
    code, outcome, msg = classify(env, unit, rc, args.cpu_sec)
    if adm:
        adm.release()
    if code != 0 or outcome != "payload":
        eprint("outcome=%s %s" % (outcome, msg))
    sys.exit(code)


def parse_mem(args):
    try:
        mem = parse_size(args.mem)
    except ValueError as e:
        die(RC_POLICY, "policy", str(e))
    if mem < 16 * 1024 ** 2 or mem > MAX_MEM_BYTES:
        die(RC_POLICY, "policy", "--mem %s outside 16M..%dG (hard maximum, never widened)"
            % (args.mem, MAX_MEM_BYTES // GIB))
    return mem


def do_status(env):
    # Read-only: a status query never changes the live slice.
    p = unit_props(env, SLICE, "MemoryMax", "MemorySwapMax", "TasksMax")
    avail = mem_available()
    print("slice %s: MemoryMax=%s MemorySwapMax=%s TasksMax=%s" % (
        SLICE, p.get("MemoryMax"), p.get("MemorySwapMax"), p.get("TasksMax")))
    for k in range(slot_count()):
        unit = slot_unit(k)
        state = unit_state(env, unit)
        if state_is_free(state):
            print("emulator slot %d: free %s" % (k, unit))
        else:
            print("emulator slot %d: busy %s (%s)" % (k, unit, state or "state unreadable"))
    print("host MemAvailable: %.1f GiB (need %d GiB) -> admission %s" % (
        avail / GIB, MIN_HEADROOM_BYTES // GIB,
        "ok" if avail >= MIN_HEADROOM_BYTES else "refused (low headroom)"))
    return 0


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    cmd = []
    if "--" in argv:
        i = argv.index("--")
        argv, cmd = argv[:i], argv[i + 1:]
    p = argparse.ArgumentParser(prog="c55x-contained", add_help=True)
    p.add_argument("--job", choices=("emulator", "work"), default="emulator")
    p.add_argument("--mem", default="1G")
    p.add_argument("--cpu-sec", type=int, default=MAX_CPU_SEC)
    p.add_argument("--wall-sec", type=int, default=MAX_WALL_SEC)
    p.add_argument("--work-dir", default=str(REPO_ROOT / "build" / "work"),
                   help="TMPDIR for the job; must be disk-backed (default: <repo>/build/work)")
    p.add_argument("--status", action="store_true")
    p.add_argument("--env", action="append", default=[], metavar="NAME",
                   help="also forward this environment variable (name only; repeatable)")
    p.add_argument("--inner", action="store_true", help=argparse.SUPPRESS)
    p.add_argument("--unit", help=argparse.SUPPRESS)
    p.add_argument("--mem-bytes", type=int, help=argparse.SUPPRESS)
    p.add_argument("--as-bytes", type=int, help=argparse.SUPPRESS)
    args = p.parse_args(argv)
    args.cmd = cmd
    if args.inner:
        return inner_verify(args)
    return run_job(args)


if __name__ == "__main__":
    sys.exit(main())
