#!/usr/bin/env python3
"""c55x-contained: the only supported way to run the emulator core.

Places a payload in a systemd user-slice with cgroup v2 limits (memory,
swap, tasks, CPU, wall time), verifies the kernel-enforced values before
starting, admits at most one emulator job at a time across all worktrees,
and reports distinct outcomes for policy failure, busy admission, low host
memory headroom, timeout, local OOM, and payload failure.

Exit codes:
  0        payload exited 0
  1-63     payload's own non-zero exit status
  70       payload result incomplete / exit code collides with a reserved code
  74       host memory headroom below the admission threshold (16 GiB)
  75       another emulator job is running (busy)
  77       policy refused (cgroup, limits, user manager or work dir not verifiable)
  79       job hit its memory ceiling (local cgroup OOM kill)
  124      wall-clock or CPU time limit reached
  128+N    payload killed by signal N

Usage: c55x-contained [--job emulator|work] [--mem SIZE] [--cpu-sec N]
                      [--wall-sec N] [--work-dir DIR] [--status] -- CMD...
"""

import argparse
import errno
import fcntl
import json
import math
import os
import re
import shutil
import stat
import subprocess
import sys
import time
from pathlib import Path

SLICE = "c55x.slice"
EMU_UNIT = "c55x-emu.service"
LOCK_DIR = Path("/run/user") / str(os.getuid()) / "c55x-contained"

# hard ceilings: a request above these is refused, not clamped
MAX_MEM_BYTES = 2 * 1024**3
MAX_CPU_SEC = 600
MAX_WALL_SEC = 900
MIN_HEADROOM_BYTES = 16 * 1024**3
# shared slice: all jobs combined
SLICE_MEM_MAX = 4 * 1024**3
SLICE_MEM_HIGH = 3 * 1024**3
SLICE_TASKS = 64
SLICE_CPU_PCT = 200
# per job (non-overridable)
JOB_TASKS = 32
JOB_CPU_PCT = 100
JOB_FDS = 512
JOB_STOP_SEC = 5

RC_OK = 0
RC_INCOMPLETE = 70
RC_HEADROOM = 74
RC_BUSY = 75
RC_POLICY = 77
RC_OOM = 79
RC_TIMEOUT = 124

UNIT_OOM = "oom-kill"
UNIT_TIMEOUT = "timeout"
UNIT_SIGNAL = "signal"


def eprint(msg):
    sys.stderr.write(f"c55x-contained: {msg}\n")


def die(rc, outcome, msg):
    eprint(f"outcome={outcome} {msg}")
    sys.exit(rc)


def parse_size(s):
    s = s.strip().upper()
    for suf, mult in (("G", 1024**3), ("M", 1024**2), ("K", 1024), ("", 1)):
        if s.endswith(suf) and s[: -len(suf) or None].isdigit():
            return int(s[: -len(suf) or None]) * mult
    if s.isdigit():
        return int(s)
    raise ValueError(f"bad size {s!r}")


# ---------------------------------------------------------------- discovery


def user_bus_env():
    """Return (env, runtime_dir) for the user manager, or None."""
    uid = os.getuid()
    for rt in (os.environ.get("XDG_RUNTIME_DIR"), f"/run/user/{uid}"):
        if not rt:
            continue
        rt = Path(rt)
        bus = rt / "bus"
        if not bus.is_socket():
            continue
        try:
            if rt.stat().st_uid != uid:
                continue
        except OSError:
            continue
        env = dict(os.environ)
        env["DBUS_SESSION_BUS_ADDRESS"] = f"unix:path={bus}"
        env["XDG_RUNTIME_DIR"] = str(rt)
        return env, rt
    return None


def systemctl(env, *args, check=True):
    cmd = ["systemctl", "--user", *args]
    r = subprocess.run(cmd, env=env, capture_output=True, text=True)
    if check and r.returncode != 0:
        raise RuntimeError(
            f"{' '.join(cmd)} rc={r.returncode} {r.stderr.strip()[:200]}")
    return r


def verify_slice(env):
    """Create the shared slice limits and read back the kernel values."""
    systemctl(env, "set-property", "--runtime", SLICE,
              f"MemoryMax={SLICE_MEM_MAX}",
              f"MemoryHigh={SLICE_MEM_HIGH}",
              "MemorySwapMax=0",
              f"TasksMax={SLICE_TASKS}",
              f"CPUQuota={SLICE_CPU_PCT}%")
    out = systemctl(env, "show", SLICE,
                    "-p", "LoadState", "-p", "ActiveState",
                    "-p", "MemoryMax", "-p", "MemorySwapMax",
                    "-p", "TasksMax", "-p", "CPUQuotaPerSecUSec").stdout
    v = {}
    for line in out.strip().splitlines():
        if "=" in line:
            k, val = line.split("=", 1)
            v[k] = val
    if v.get("LoadState") != "loaded":
        return None, f"slice {SLICE} LoadState={v.get('LoadState')}"
    if v.get("MemoryMax") != str(SLICE_MEM_MAX):
        return None, f"slice MemoryMax={v.get('MemoryMax')} != {SLICE_MEM_MAX}"
    if v.get("MemorySwapMax") != "0":
        return None, f"slice MemorySwapMax={v.get('MemorySwapMax')} != 0"
    if v.get("TasksMax") not in (str(SLICE_TASKS), str(SLICE_TASKS)):
        return None, f"slice TasksMax={v.get('TasksMax')} != {SLICE_TASKS}"
    return v, None


def mem_available():
    with open("/proc/meminfo") as f:
        for line in f:
            if line.startswith("MemAvailable:"):
                return int(line.split()[1]) * 1024
    return 0


def is_tmpfs(path):
    """True if the resolved path is on a tmpfs mount."""
    p = Path(path).resolve()
    try:
        with open("/proc/self/mountinfo") as f:
            for line in f:
                # format: id parent major:minor root mountpoint opts ... - fstype src ...
                if " - " not in line:
                    continue
                left, right = line.split(" - ", 1)
                left_parts = left.split()
                fstype = right.split()[0] if right.strip() else ""
                mp = left_parts[4] if len(left_parts) > 4 else ""
                if "tmpfs" in fstype and mp:
                    try:
                        if p.is_relative_to(Path(mp)):
                            return True
                    except (ValueError, OSError):
                        pass
    except OSError:
        pass
    return False


# ---------------------------------------------------------------- admission


class Admission:
    """Owner-checked lock for the single emulator job slot."""

    def __init__(self):
        self.fd = None
        self.path = None

    def acquire(self):
        LOCK_DIR.mkdir(parents=True, exist_ok=True)
        self.path = LOCK_DIR / "emulator.lock"
        self.fd = os.open(self.path, os.O_CREAT | os.O_RDWR, 0o600)
        try:
            fcntl.flock(self.fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError as e:
            if e.errno in (errno.EWOULDBLOCK, errno.EAGAIN):
                return False
            raise
        os.ftruncate(self.fd, 0)
        os.write(self.fd, f"{os.getpid()}\n".encode())
        return True

    def release(self):
        if self.fd is not None:
            try:
                fcntl.flock(self.fd, fcntl.LOCK_UN)
            except OSError:
                pass
            os.close(self.fd)
            self.fd = None


def kill_stale_unit(env):
    """Ensure no leftover emulator unit from a previous launcher crash."""
    r = systemctl(env, "is-active", "--quiet", EMU_UNIT, check=False)
    if r.returncode == 0:
        systemctl(env, "stop", EMU_UNIT, check=False)
        # wait up to the stop grace for it to disappear
        for _ in range(JOB_STOP_SEC * 2):
            r = systemctl(env, "is-active", "--quiet", EMU_UNIT, check=False)
            if r.returncode != 0:
                break
            time.sleep(0.5)
        r = systemctl(env, "is-active", "--quiet", EMU_UNIT, check=False)
        if r.returncode == 0:
            return False, f"{EMU_UNIT} still active after stop"
    systemctl(env, "reset-failed", EMU_UNIT, check=False)
    return True, None


# ---------------------------------------------------------------- run


def do_status(env):
    v, err = verify_slice(env)
    if err:
        die(RC_POLICY, "policy", err)
    avail = mem_available()
    r = systemctl(env, "is-active", "--quiet", EMU_UNIT, check=False)
    busy = r.returncode == 0
    print(f"slice: {SLICE} OK (mem={SLICE_MEM_MAX}, swap=0, "
          f"tasks={SLICE_TASKS}, cpu={SLICE_CPU_PCT}%)")
    print(f"emulator slot: {'busy' if busy else 'free'}")
    print(f"host MemAvailable: {avail / 1024**3:.1f} GiB "
          f"(need {MIN_HEADROOM_BYTES // 1024**3} GiB)")
    adm = "ok" if avail >= MIN_HEADROOM_BYTES else "low"
    print(f"admission: {adm}")
    sys.exit(0)


def run_job(args):
    env_bus = user_bus_env()
    if env_bus is None:
        die(RC_POLICY, "policy", "no user manager bus socket found")
    env, rt = env_bus

    if args.status:
        do_status(env)

    # verify and set the shared slice
    _, err = verify_slice(env)
    if err:
        die(RC_POLICY, "policy", f"shared slice: {err}")

    # headroom
    avail = mem_available()
    if avail < MIN_HEADROOM_BYTES:
        die(RC_HEADROOM, "headroom",
            f"MemAvailable {avail // 1024**3} GiB < "
            f"{MIN_HEADROOM_BYTES // 1024**3} GiB")

    # work dir
    work_dir = Path(args.work_dir).resolve()
    if is_tmpfs(work_dir):
        die(RC_POLICY, "policy",
            f"work dir {work_dir} is on tmpfs; use a disk-backed directory")
    work_dir.mkdir(parents=True, exist_ok=True)

    # admission
    if args.job == "emulator":
        adm = Admission()
        if not adm.acquire():
            die(RC_BUSY, "busy",
                "another emulator job is running; wait for it to finish")
        ok, err = kill_stale_unit(env)
        if not ok:
            adm.release()
            die(RC_BUSY, "busy", err)

    # payload
    cmd = args.cmd
    if not cmd:
        die(RC_POLICY, "policy", "no command after --")

    mem = parse_size(args.mem)
    if mem > MAX_MEM_BYTES:
        die(RC_POLICY, "policy",
            f"--mem {args.mem} exceeds the hard maximum "
            f"of {MAX_MEM_BYTES // 1024**3}G")
    cpu_sec = min(args.cpu_sec, MAX_CPU_SEC)
    if args.cpu_sec > MAX_CPU_SEC:
        die(RC_POLICY, "policy",
            f"--cpu-sec {args.cpu_sec} exceeds the hard maximum of {MAX_CPU_SEC}")
    wall_sec = min(args.wall_sec, MAX_WALL_SEC)
    if args.wall_sec > MAX_WALL_SEC:
        die(RC_POLICY, "policy",
            f"--wall-sec {args.wall_sec} exceeds the hard maximum of {MAX_WALL_SEC}")

    # ASan needs a large virtual address space; the physical ceiling stays
    # bounded by the cgroup memory.max
    limit_as = 16 * 1024**3 if args.job == "work" else 2 * 1024**3

    unit = EMU_UNIT if args.job == "emulator" else ""
    props = [
        f"MemoryMax={mem}",
        "MemorySwapMax=0",
        f"TasksMax={JOB_TASKS}",
        f"CPUQuota={JOB_CPU_PCT}%",
        "OOMPolicy=kill",
        f"RuntimeMaxSec={wall_sec}",
        f"TimeoutStopSec={JOB_STOP_SEC}",
        f"LimitCPU={cpu_sec}",
        f"LimitNOFILE={JOB_FDS}",
        "LimitCORE=0",
        f"LimitAS={limit_as}",
        "PrivateTmp=no",
    ]

    run_args = ["systemd-run", "--user", "--wait", "--pipe", "--quiet",
                "--expand-environment=no",
                f"--slice={SLICE}",
                "--working-directory", os.getcwd()]
    if unit:
        run_args += [f"--unit={unit}"]
    for p in props:
        run_args += ["-p", p]
    run_args += ["--setenv", f"TMPDIR={work_dir}",
                 "--setenv", f"OPENBLAS_NUM_THREADS=1",
                 "--setenv", f"OMP_NUM_THREADS=1",
                 "--setenv", f"C55X_CONTAINED_JOB={args.job}"]

    run_args.append("--")
    run_args.extend(cmd)

    try:
        r = subprocess.run(run_args, env=env, cwd=os.getcwd())
    except KeyboardInterrupt:
        # launcher interrupted: stop the unit (its descendants stay inside
        # the cgroup until the stop grace expires)
        systemctl(env, "stop", unit or "c55x-run.scope", check=False)
        die(130, "interrupted", "launcher interrupted; job stopped")

    rc = r.returncode

    # determine the actual outcome from the unit result
    outcome = "payload"
    if unit:
        out = systemctl(env, "show", unit, "-p", "Result",
                        "-p", "ExecMainStatus", check=False).stdout
        vals = {}
        for line in out.strip().splitlines():
            if "=" in line:
                k, v = line.split("=", 1)
                vals[k] = v
        result = vals.get("Result", "")
        exec_status = int(vals.get("ExecMainStatus", "0") or "0")
        systemctl(env, "reset-failed", unit, check=False)
        if result == UNIT_OOM:
            if args.job == "emulator":
                adm.release()
            die(RC_OOM, "oom",
                f"job exceeded its {args.mem} memory ceiling and was killed")
        if result == UNIT_TIMEOUT:
            if args.job == "emulator":
                adm.release()
            die(RC_TIMEOUT, "timeout",
                f"job exceeded its {wall_sec}s wall-time limit")
        if result == UNIT_SIGNAL and exec_status in (9, 15) and rc in (1, 255):
            # systemd-run returns 1 or 255 for signal-killed units
            if args.job == "emulator":
                adm.release()
            die(128 + exec_status, "signal",
                f"job killed by signal {exec_status}")
        if rc in (RC_HEADROOM, RC_BUSY, RC_POLICY, RC_OOM, RC_TIMEOUT,
                  RC_INCOMPLETE) and result not in ("success", "exit-code"):
            # reserved code from the payload: remap to incomplete
            if args.job == "emulator":
                adm.release()
            die(RC_INCOMPLETE, "incomplete",
                f"payload exit code {rc} collides with a reserved code; "
                f"unit Result={result}")
        # normal: exit-code propagates the payload's status
        final_rc = rc if rc >= 0 else 256 + rc

    if args.job == "emulator":
        adm.release()
    eprint(f"outcome=payload rc={final_rc}")
    sys.exit(final_rc)


def main():
    # manual split: everything before '--' is options, after is the payload
    argv = sys.argv[1:]
    if "--" in argv:
        idx = argv.index("--")
        opts = argv[:idx]
        cmd = argv[idx + 1:]
    else:
        opts = argv
        cmd = []
    p = argparse.ArgumentParser(add_help=False)
    p.add_argument("--job", choices=("emulator", "work"), default="emulator")
    p.add_argument("--mem", default="1G")
    p.add_argument("--cpu-sec", type=int, default=MAX_CPU_SEC)
    p.add_argument("--wall-sec", type=int, default=MAX_WALL_SEC)
    p.add_argument("--work-dir", default="build/work")
    p.add_argument("--status", action="store_true")
    args = p.parse_args(opts)
    args.cmd = cmd
    if not args.status and not args.cmd:
        p.print_usage(sys.stderr)
        eprint("no command after --")
        sys.exit(RC_POLICY)
    run_job(args)


if __name__ == "__main__":
    main()
